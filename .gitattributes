# Normalize line endings — keep LF in the repo regardless of OS.
* text=auto eol=lf

# Test fixtures are compared byte-for-byte (serialized IR golden files) —
# never normalize them.
testdata/** -text
cli/**/testdata/** -text
ir/testdata/** -text

# Binary assets (don't diff/normalize).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# Generated/vendored — collapse in diffs and exclude from language stats.
go.sum linguist-generated=true
*.gen.go linguist-generated=true
vendor/** linguist-vendored
