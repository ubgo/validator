{
  "name": "@ubgo/validator",
  "version": "0.0.0",
  "description": "Standard-Schema-compatible TypeScript runtime for schemas generated by github.com/ubgo/validator: Ajv validation of the exported JSON Schema, honest handling of the portability manifest (stub-and-warn, server round-trip), and Go-identical error codes.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cover": "vitest run --coverage",
    "lint": "eslint src test",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-ts": "^3.1.1"
  },
  "devDependencies": {
    "@hono/standard-validator": "^0.1.5",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^3.2.4",
    "hono": "^4.13.7",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
